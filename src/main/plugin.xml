<?xml version="1.0" encoding="UTF-8"?>
<plugin id="${id}" version="${version}">
  <!-- DITA to Markdown -->
  <transtype name="markdown" desc="Markdown DITA, fails if source text is missing from the output">
    <param name="markdown.verify" desc="Compare every output file with its source topic and report text that is missing." type="enum">
      <val default="true">yes</val>
      <val>no</val>
    </param>
    <param name="markdown.verify.fail" desc="Fail the build when the comparison finds missing text." type="enum">
      <val default="true">yes</val>
      <val>no</val>
    </param>
    <param name="markdown.verify.source" desc="What to do with text that is in an authored topic but was removed by filtering or by conref and key resolution before the conversion: list it, fail the build, or skip the comparison." type="enum">
      <val default="true">report</val>
      <val>fail</val>
      <val>no</val>
    </param>
    <param name="markdown.admonition.style" desc="Syntax for notes. mkdocs is built in; other plug-ins add styles through the dita.xsl.markdown.admonition extension point." type="string"/>
    <param name="markdown.heal" desc="Append source text that no template placed, under a heading at the end of the topic." type="enum">
      <val default="true">yes</val>
      <val>no</val>
    </param>
    <param name="markdown.conref" desc="Keep each conref as raw DITA that the Markdown DITA parser reads back, or resolve conrefs before the conversion." type="enum">
      <val default="true">keep</val>
      <val>resolve</val>
    </param>
  </transtype>
  <transtype name="markdown_github" desc="GitHub-flavored Markdown"/>
  <transtype name="markdown_gitbook" desc="GitBook"/>
  <transtype name="mdx" desc="MDX"/>
  <feature extension="dita.conductor.target.relative" file="conductor.xml"/>
  <!-- common -->
  <feature extension="dita.conductor.lib.import" file="lib/${id}-${version}.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/htmlparser-1.4.jar"/>
  <!-- Markdown to DITA -->
  <template file="build-markdown_template.xml"/>
  <template file="xsl/dita2markdown_template.xsl"/>
  <template file="xsl/dita2markdown_lossless_template.xsl"/>
  <!--template file="xsl/map2markdown-toc_template.xsl"/-->
  <template file="xsl/map2markdown-cover_template.xsl"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-abbreviation-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-admonition-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-anchorlink-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-attributes-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-autolink-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-definition-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-footnotes-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-gfm-strikethrough-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-jekyll-tag-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-ins-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-resizable-image-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-superscript-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-tables-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-typographic-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-ext-yaml-front-matter-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-format-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-ast-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-builder-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-dependency-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-html-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-sequence-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-collection-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-data-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-misc-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/flexmark-util-visitor-0.64.8.jar"/>
  <feature extension="dita.conductor.lib.import" file="lib/autolink-0.6.0.jar"/>
  <feature extension="dita.xsl.html5" file="xsl/linebreak2html5.xsl"/>
  <feature extension="dita.xsl.xslfo" file="xsl/linebreak2fo.xsl"/>
  <feature extension="dita.parser">
    <!-- md and markdown are the same source format under two DITA-OT names,
         so they enable the same features. Enabling implicit task sections for
         md alone meant the same file produced <prereq> through one topicref
         and a nested <task> through the other. -->
    <parser format="markdown" class="com.elovirta.dita.markdown.MarkdownReader">
      <feature name="http://lwdita.org/sax/features/implicit-task-sections" value="true"/>
    </parser>
    <parser format="md" class="com.elovirta.dita.markdown.MarkdownReader">
      <feature name="http://lwdita.org/sax/features/implicit-task-sections" value="true"/>
    </parser>
    <parser format="mdita" class="com.elovirta.dita.markdown.MDitaReader"/>
    <parser format="mditamap" class="com.elovirta.dita.markdown.MDitamapReader"/>
    <parser format="wikidocs" class="com.elovirta.dita.markdown.MarkdownReader">
      <feature name="http://lwdita.org/sax/features/shortdesc-paragraph" value="true"/>
      <feature name="http://lwdita.org/sax/features/wiki" value="true"/>
    </parser>
  </feature>
  <extension-point id="dita.xsl.markdown" name="Markdown overrides XSLT import"/>
  <extension-point id="dita.xsl.markdown.admonition" name="Markdown admonition style XSLT import"/>
  <!-- HTML to DITA -->
  <template file="build-html_template.xml"/>
  <feature extension="dita.parser">
    <parser format="hdita" class="com.elovirta.dita.html.HDitaReader"/>
  </feature>
</plugin>
