<?xml version="1.0" encoding="UTF-8"?>
<task xmlns:ditaarch="http://dita.oasis-open.org/architecture/2005/"
      class="- topic/topic task/task "
      ditaarch:DITAArchVersion="2.0"
      specializations="@props/audience @props/deliveryTarget @props/otherprops @props/platform @props/product"
      id="deploy-the-app">
   <title class="- topic/title ">Deploy the app</title>
   <shortdesc class="- topic/shortdesc ">Gather these items:</shortdesc>
   <taskbody class="- topic/body task/taskbody ">
      <context class="- topic/section task/context ">
         <ul class="- topic/ul ">
            <li class="- topic/li ">SSH key</li>
            <li class="- topic/li ">Config file</li>
            <li class="- topic/li ">Access token</li>
         </ul>
      </context>
      <steps class="- topic/ol task/steps ">
         <step class="- topic/li task/step ">
            <cmd class="- topic/ph task/cmd ">Connect to the server.</cmd>
         </step>
         <step class="- topic/li task/step ">
            <cmd class="- topic/ph task/cmd ">Run the deploy script.</cmd>
         </step>
      </steps>
   </taskbody>
</task>
